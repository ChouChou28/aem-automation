{
  "manifest_version": 3,
  "name": "AEM Cookie Bridge",
  "version": "1.1.0",
  "description": "Read Samsung AEM cookies (including HttpOnly) and send them to the Automation app.",
  "permissions": ["cookies", "tabs", "storage", "scripting"],
  "host_permissions": ["*://*.samsung.com/*", "*://samsung.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AEM Cookie Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
